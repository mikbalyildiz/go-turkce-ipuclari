+// Konu: README.md, 9. map'e aynı anda birden fazla goroutine'den yazmak
+// Hatalı sürüm programı tamamen çökerttiği için (recover ile yakalanamaz) burada sadece doğru sürüm var.
+// Çalıştırmak için: go run -race ./ornekler/hata-09-esz-map-yazma
+package main // çalıştırılabilir program
+
+import ( // kullanılan paketler
+	"fmt"  // yazdırma
+	"sync" // Mutex ve WaitGroup için
+) // import sonu
+
+func main() { // program girişi
+	var ( // paylaşılan değişkenler
+		mu    sync.Mutex         // map'i korumak için kilit
+		sayac = map[string]int{} // paylaşılan map
+		wg    sync.WaitGroup     // goroutine'leri beklemek için
+	) // var sonu
+	for i := 0; i < 100; i++ { // 100 goroutine
+		wg.Add(1)   // bekleme sayacını artır
+		go func() { // goroutine başlat
+			defer wg.Done()    // bitince sayacı azalt
+			mu.Lock()          // kilidi al
+			sayac["ziyaret"]++ // güvenli yazma
+			mu.Unlock()        // kilidi bırak
+		}() // fonksiyon hemen çağrılıyor
+	} // for sonu
+	wg.Wait()                                 // tüm goroutine'leri bekle
+	fmt.Println("✅ doğru:", sayac["ziyaret"]) // her zaman 100
+} // main sonu
