+// Konu: README.md, 5. append sonrası slice'ların aynı diziyi paylaşması
+// Çalıştırmak için: go run ./ornekler/hata-05-append-paylasim
+package main // çalıştırılabilir program
+
+import "fmt" // yazdırma paketi
+
+func main() { // program girişi
+	a := []int{1, 2, 3, 4}      // len 4, cap 4
+	b := a[:2]                  // b = [1 2], a ile aynı diziyi kullanıyor
+	b = append(b, 99)           // yer olduğu için a[2]'nin üzerine yazar
+	fmt.Println("❌ yanlış:", a) // [1 2 99 4]
+
+	c := []int{1, 2, 3, 4}               // orijinal veri
+	d := make([]int, 2)                  // d için yeni bir dizi ayır
+	copy(d, c[:2])                       // ilk iki elemanı kopyala
+	d = append(d, 99)                    // artık c etkilenmez
+	fmt.Println("✅ doğru (copy):", c, d) // [1 2 3 4] [1 2 99]
+
+	e := []int{1, 2, 3, 4}                  // orijinal veri
+	f := e[:2:2]                            // kapasiteyi 2 ile sınırla
+	f = append(f, 99)                       // kapasite dolu, yeni dizi oluşturulur
+	fmt.Println("✅ doğru (a[:2:2]):", e, f) // [1 2 3 4] [1 2 99]
+} // main sonu
