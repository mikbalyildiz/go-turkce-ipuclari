+// Konu: README.md, 10. Türkçe karakterli string'i byte ile işlemek
+// Çalıştırmak için: go run ./ornekler/hata-10-turkce-string
+package main // çalıştırılabilir program
+
+import ( // kullanılan paketler
+	"fmt"          // yazdırma
+	"strings"      // büyük/küçük harf dönüşümü
+	"unicode"      // Türkçe harf kuralları
+	"unicode/utf8" // UTF-8 karakter sayımı
+) // import sonu
+
+func main() { // program girişi
+	s := "Işık"                                 // 4 harf
+	fmt.Println("❌ yanlış len:", len(s))        // 6 (byte sayısı)
+	fmt.Printf("❌ yanlış s[0:2]: %q\n", s[0:2]) // "I\xc5" bozuk parça
+
+	r := []rune(s)                                           // karakterlere (rune) çevir
+	fmt.Println("✅ doğru len:", len(r))                      // 4
+	fmt.Println("✅ doğru ilk iki harf:", string(r[0:2]))     // Iş
+	fmt.Println("✅ doğru sayım:", utf8.RuneCountInString(s)) // kopya oluşturmadan: 4
+
+	fmt.Println("❌ yanlış büyük harf:", strings.ToUpper("istanbul"))                            // ISTANBUL
+	fmt.Println("✅ doğru büyük harf:", strings.ToUpperSpecial(unicode.TurkishCase, "istanbul")) // İSTANBUL
+} // main sonu
