 ## 9. map'e aynı anda birden fazla goroutine'den yazmak
diff --git a/ornekler/hata-08-range-kopya/main.go b/ornekler/hata-08-range-kopya/main.go
new file mode 100644
index 0000000..c9abb1c
--- /dev/null
+++ b/ornekler/hata-08-range-kopya/main.go
@@ -0,0 +1,21 @@
+// Konu: README.md, 8. range ile kopya üzerinde değişiklik yapmak
+// Çalıştırmak için: go run ./ornekler/hata-08-range-kopya
+package main // çalıştırılabilir program
+
+import "fmt" // yazdırma paketi
+
+type Ogrenci struct{ Not int } // basit yapı
+
+func main() { // program girişi
+	liste := []Ogrenci{{50}, {60}} // iki öğrenci
+	for _, o := range liste {      // o her turda bir kopya
+		o.Not += 10 // sadece kopya değişir
+		_ = o       // kopya kullanılmadan atılır
+	} // for sonu
+	fmt.Println("❌ yanlış:", liste) // [{50} {60}]
+
+	for i := range liste { // indeks üzerinden dön
+		liste[i].Not += 10 // asıl eleman değişir
+	} // for sonu
+	fmt.Println("✅ doğru:", liste) // [{60} {70}]
+} // main sonu
