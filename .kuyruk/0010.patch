 ## 2. Döngü değişkenini goroutine içinde kullanmak
diff --git a/ornekler/hata-01-nil-map/main.go b/ornekler/hata-01-nil-map/main.go
new file mode 100644
index 0000000..9cacf35
--- /dev/null
+++ b/ornekler/hata-01-nil-map/main.go
@@ -0,0 +1,27 @@
+// Konu: README.md, 1. nil map'e yazmak
+// Çalıştırmak için: go run ./ornekler/hata-01-nil-map
+package main // çalıştırılabilir program
+
+import "fmt" // yazdırma paketi
+
+func yanlis() { // hatalı kullanımı güvenle gösteren fonksiyon
+	defer func() { // fonksiyon biterken çalışacak kurtarma bloğu
+		if r := recover(); r != nil { // panic olduysa yakala
+			fmt.Println("❌ yanlış:", r) // panic mesajını yazdır
+		} // if sonu
+	}() // ertelenen fonksiyonu hemen tanımla
+	var notlar map[string]int                    // map tanımlandı ama oluşturulmadı, değeri nil
+	fmt.Println("nil map okuma:", notlar["ali"]) // okumak sorunsuz, 0 döner
+	notlar["ali"] = 90                           // yazmak panic üretir
+} // yanlis sonu
+
+func dogru() { // doğru kullanım
+	notlar := make(map[string]int)  // make ile map bellekte oluşturulur
+	notlar["ali"] = 90              // artık güvenle yazılabilir
+	fmt.Println("✅ doğru:", notlar) // map[ali:90]
+} // dogru sonu
+
+func main() { // program girişi
+	yanlis() // önce hatalı örnek
+	dogru()  // sonra doğru örnek
+} // main sonu
