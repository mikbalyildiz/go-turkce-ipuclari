+// Konu: README.md, 7. interface nil tuzağı
+// Çalıştırmak için: go run ./ornekler/hata-07-interface-nil
+package main // çalıştırılabilir program
+
+import "fmt" // yazdırma paketi
+
+type BenimHatam struct{} // özel hata tipi
+
+func (e *BenimHatam) Error() string { return "benim hatam" } // error interface'ini karşılar
+
+func yanlisIslem() error { // dönüş tipi error interface'i
+	var h *BenimHatam // nil işaretçi
+	return h          // interface'e sarıldı, tipi *BenimHatam, değeri nil
+} // yanlisIslem sonu
+
+func dogruIslem() error { // dönüş tipi error interface'i
+	var h *BenimHatam // hata oluşabilecek değişken
+	if h == nil {     // gerçekten hata yoksa
+		return nil // açıkça nil interface döndür
+	} // if sonu
+	return h // hata varsa döndür
+} // dogruIslem sonu
+
+func main() { // program girişi
+	err := yanlisIslem()                                                // hatalı fonksiyonu çağır
+	fmt.Printf("❌ yanlış: err != nil → %v, tip: %T\n", err != nil, err) // true, *main.BenimHatam
+	err = dogruIslem()                                                  // doğru fonksiyonu çağır
+	fmt.Printf("✅ doğru: err != nil → %v, tip: %T\n", err != nil, err)  // false, <nil>
+} // main sonu
