 ## 5. append sonrası slice'ların aynı diziyi paylaşması
diff --git a/ornekler/hata-04-defer-sirasi/main.go b/ornekler/hata-04-defer-sirasi/main.go
new file mode 100644
index 0000000..a0061b2
--- /dev/null
+++ b/ornekler/hata-04-defer-sirasi/main.go
@@ -0,0 +1,25 @@
+// Konu: README.md, 4. defer sırasını yanlış bilmek
+// Çalıştırmak için: go run ./ornekler/hata-04-defer-sirasi
+package main // çalıştırılabilir program
+
+import "fmt" // yazdırma paketi
+
+func lifo() { // defer sırasını gösteren fonksiyon
+	for i := 1; i <= 3; i++ { // 1, 2, 3 için döner
+		defer fmt.Println("defer", i) // son giren ilk çıkar: 3 2 1
+	} // for sonu
+	fmt.Println("döngü bitti, defer'ler şimdi çalışacak") // önce bu satır basılır
+} // fonksiyon biterken defer'ler ters sırayla çalışır
+
+func dosyaIsle(ad string) { // her dosya için ayrı fonksiyon kapsamı
+	fmt.Println("açıldı:", ad)        // dosyayı açmayı temsil eder
+	defer fmt.Println("kapandı:", ad) // bu fonksiyon bitince hemen çalışır
+	fmt.Println("işlendi:", ad)       // asıl iş
+} // dosya burada kapanır, döngünün sonunu beklemez
+
+func main() { // program girişi
+	lifo()                                          // LIFO örneği
+	for _, ad := range []string{"a.txt", "b.txt"} { // iki dosya dolaş
+		dosyaIsle(ad) // ✅ doğru: her dosya kendi turunda kapanır
+	} // for sonu
+} // main sonu
