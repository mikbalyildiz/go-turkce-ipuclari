 ## 3. main'in goroutine'leri beklemeyeceğini unutmak
diff --git a/ornekler/hata-02-dongu-degiskeni/main.go b/ornekler/hata-02-dongu-degiskeni/main.go
new file mode 100644
index 0000000..2f858e1
--- /dev/null
+++ b/ornekler/hata-02-dongu-degiskeni/main.go
@@ -0,0 +1,30 @@
+// Konu: README.md, 2. Döngü değişkenini goroutine içinde kullanmak
+// Not: Go 1.22+ her turda yeni değişken oluşturur, eski davranış sadece Go ≤ 1.21'de görülür.
+// Çalıştırmak için: go run ./ornekler/hata-02-dongu-degiskeni
+package main // çalıştırılabilir program
+
+import ( // kullanılan paketler
+	"fmt"  // yazdırma
+	"sort" // sonuçları sıralamak için
+	"sync" // WaitGroup ve Mutex için
+) // import sonu
+
+func main() { // program girişi
+	var wg sync.WaitGroup // goroutine'leri beklemek için sayaç
+	var mu sync.Mutex     // sonuç listesini korumak için kilit
+	var sonuc []int       // goroutine'lerin bastığı değerler
+
+	for i := 0; i < 3; i++ { // üç tur dön
+		wg.Add(1)        // bir goroutine bekleneceğini bildir
+		go func(n int) { // değeri parametre olarak al, her sürümde doğru çalışır
+			defer wg.Done()          // bitince sayacı azalt
+			mu.Lock()                // listeye yazmadan önce kilitle
+			sonuc = append(sonuc, n) // goroutine'in gördüğü değeri ekle
+			mu.Unlock()              // kilidi bırak
+		}(i) // i'nin o anki değeri gönderilir
+	} // for sonu
+
+	wg.Wait()                      // tüm goroutine'leri bekle
+	sort.Ints(sonuc)               // goroutine sırası rastgele, karşılaştırmak için sırala
+	fmt.Println("✅ doğru:", sonuc) // [0 1 2]
+} // main sonu
