+// Konu: README.md, 6. Hataları yok saymak
+// Çalıştırmak için: go run ./ornekler/hata-06-hata-yok-sayma
+package main // çalıştırılabilir program
+
+import ( // kullanılan paketler
+	"fmt"     // yazdırma ve hata sarma
+	"strconv" // metni sayıya çevirmek için
+) // import sonu
+
+func ikiKati(metin string) (int, error) { // hatayı yukarı ileten doğru kullanım
+	sayi, err := strconv.Atoi(metin) // hatayı değişkene al
+	if err != nil {                  // hata var mı kontrol et
+		return 0, fmt.Errorf("sayı okunamadı: %w", err) // bağlam ekleyip yukarı ilet
+	} // if sonu
+	return sayi * 2, nil // sadece geçerli değerle devam et
+} // ikiKati sonu
+
+func main() { // program girişi
+	sayi, _ := strconv.Atoi("12a")   // ❌ hata yok sayıldı
+	fmt.Println("❌ yanlış:", sayi*2) // 0 basar ve hiçbir uyarı vermez
+
+	for _, girdi := range []string{"21", "12a"} { // biri geçerli, biri hatalı girdi
+		sonuc, err := ikiKati(girdi) // ✅ hatayı al
+		if err != nil {              // hata varsa
+			fmt.Println("✅ doğru, hata yakalandı:", err) // anlamlı mesaj
+			continue                                     // sıradaki girdiye geç
+		} // if sonu
+		fmt.Println("✅ doğru:", sonuc) // 42
+	} // for sonu
+} // main sonu
