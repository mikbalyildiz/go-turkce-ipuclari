 ## 4. defer sırasını yanlış bilmek
diff --git a/ornekler/hata-03-main-beklemez/main.go b/ornekler/hata-03-main-beklemez/main.go
new file mode 100644
index 0000000..b390782
--- /dev/null
+++ b/ornekler/hata-03-main-beklemez/main.go
@@ -0,0 +1,21 @@
+// Konu: README.md, 3. main'in goroutine'leri beklemeyeceğini unutmak
+// Çalıştırmak için: go run ./ornekler/hata-03-main-beklemez
+package main // çalıştırılabilir program
+
+import ( // kullanılan paketler
+	"fmt"  // yazdırma
+	"sync" // WaitGroup için
+) // import sonu
+
+func main() { // program buradan başlar
+	var wg sync.WaitGroup     // bekleme sayacı
+	for i := 1; i <= 3; i++ { // üç goroutine başlat
+		wg.Add(1)        // bir goroutine bekleneceğini bildir
+		go func(n int) { // goroutine başlat
+			defer wg.Done()           // iş bitince sayacı bir azalt
+			fmt.Println("merhaba", n) // asıl iş
+		}(i) // sıra numarasını gönder
+	} // for sonu
+	wg.Wait()                                // sayaç sıfırlanana kadar bekle, bu satır silinirse çıktı görünmeyebilir
+	fmt.Println("✅ tüm goroutine'ler bitti") // artık güvenle bitebilir
+} // main sonu
